# ==============================================================================
# Telegram Membership Bot Configuration (.env)
# ==============================================================================

# Telegram Bot API Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Target Private Channel ID (Primary / Old Channel)
CHANNEL_ID=-1003758847086

# Secondary / New Target Channel ID (Optional, for moved users)
# SECONDARY_CHANNEL_ID=-1001234567890

# Tertiary / V3 Target Channel ID (Optional, for moved V3 users)
# TERTIARY_CHANNEL_ID=-1003900142712

# Admin Group ID (Slip verification & approvals)
ADMIN_GROUP_ID=-5596543919

# Admin Mention (Telegram tag when user buys package/DMs/reminders)
ADMIN_MENTION=@sgrtbl

# SQLite Database URL
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# Payment Information shown to users
PROMPT_PAYMENT_INFO="💳 สมัครสมาชิก VIP 30 วัน (ราคา 300 บาท)\n\n📲 สแกน QR Code พร้อมเพย์เพื่อชำระเงิน\n• ยอดชำระ: 300 บาท\n• สแกนจ่ายผ่านแอปธนาคารได้ทันที\n\nเมื่อโอนเงินเรียบร้อยแล้ว กรุณาส่งรูปสลิปเข้ามาในแชทนี้ได้เลยครับ"

# Durations in minutes (Production: TRIAL=15 mins, PAID=43200 mins / 30 days)
TRIAL_DURATION_MINUTES=15
PAID_DURATION_MINUTES=43200
CHECK_INTERVAL_SECONDS=60

# Logging Level
LOG_LEVEL=INFO

# Free Community Chat Group URL
FREE_CHAT_GROUP_URL=https://t.me/barelivechat

